{
    "name": "saturon-monorepo",
    "private": true,
    "scripts": {
        "dev": "pnpm --filter saturon-docs dev",
        "start": "pnpm --filter saturon-docs start",
        "build": "pnpm --filter saturon build && pnpm --filter saturon-docs build",
        "build:lib": "pnpm --filter saturon build",
        "build:demo": "pnpm --filter saturon-demo build",
        "test": "pnpm --filter saturon test",
        "publish:lib": "pnpm --filter saturon publish --no-git-checks",
        "bench": "pnpm --filter saturon-benchmarks bench",
        "conformance:wpt": "pnpm --filter saturon-conformance wpt",
        "lint": "pnpm -r run lint",
        "lint:fix": "pnpm -r run lint:fix",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx}\""
    },
    "packageManager": "pnpm@9.0.0",
    "devDependencies": {
        "@types/node": "^26.6.2",
        "globals": "^17.13.0"
    }
}
