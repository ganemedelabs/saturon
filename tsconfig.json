{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "composite": true,
        "types": ["node"]
    },
    "files": [],
    "include": ["prettier.config.mts", "eslint.config.mts", "packages/*/eslint.config.mts", "apps/*/eslint.config.mts"],
    "references": [{ "path": "./packages/saturon" }, { "path": "./apps/docs" }]
}
